{
  "grammars": [
    {
      "name": "vora",
      "camelcase": "Vora",
      "scope": "source.vora",
      "path": ".",
      "file-types": [
        "va"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injection-regex": "^vora$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Vora programming language",
    "authors": [
      {
        "name": "Vora-lang"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-vora"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
